# Copy this file to .env and fill in your own values. Never commit .env.

# Stripe API keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret.
# Local dev: run `stripe listen --forward-to localhost:4242/webhooks/stripe` and copy the whsec_... it prints.
# Production: create the endpoint at https://dashboard.stripe.com/webhooks and copy its signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of this app (no trailing slash). Used for Checkout and Customer Portal redirects.
APP_URL=http://localhost:4242
PORT=4242

# Links shown in Checkout (terms consent) and on invoices.
TERMS_URL=https://www.solvlanguages.com/terms
PRIVACY_URL=https://www.solvlanguages.com/privacy

# Optional. Set to "true" if you are a German Kleinunternehmer (§19 UStG) and must not charge VAT.
# Products are then created with the Stripe "Nontaxable" tax code instead of the education services code.
KLEINUNTERNEHMER=false

# Optional. Set to "true" once "Bank transfers" is enabled in Dashboard > Settings > Payment methods.
# Invoices then offer card, SEPA Direct Debit and bank transfer (Stripe assigns each customer a virtual IBAN).
INVOICE_BANK_TRANSFER=false

# Optional. Customer Portal configuration id printed by `npm run setup:portal`.
STRIPE_PORTAL_CONFIG_ID=
